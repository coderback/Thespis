# Copy to .env and fill in. Never commit .env.
# Any OpenAI-compatible provider: the primary is tried first, then the backup, then the code fallback.
# Use a fast, non-reasoning model.
#
# Azure OpenAI or Azure AI Foundry (the key is sent as api-key automatically):
#   v1 endpoint:      LLM_BASE_URL=https://<resource>.openai.azure.com/openai/v1   LLM_MODEL=<deployment name>
#   deployment URL:   LLM_BASE_URL=https://<resource>.openai.azure.com/openai/deployments/<deployment>
#                     LLM_API_VERSION=<api version shown in the portal>            LLM_MODEL=<deployment name>
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_API_VERSION=
# Optional JSON merged into each request body. Use it to switch thinking off, e.g. {"enable_thinking": false},
# or set a field to null to remove it, e.g. {"max_tokens": null, "max_completion_tokens": 300}
LLM_EXTRA=
# Each call sends its fixed JSON schema as structured outputs, so the reply can't take another shape. STRUCTURED=0
# keeps a provider to JSON mode instead; a deployment that refuses schemas is switched to JSON mode automatically.
LLM_STRUCTURED=1
LLM_BACKUP_BASE_URL=
LLM_BACKUP_API_KEY=
LLM_BACKUP_MODEL=
LLM_BACKUP_API_VERSION=
LLM_BACKUP_EXTRA=
LLM_BACKUP_STRUCTURED=1
# Every reply that passes the validator is cached in the database, so a route played again makes no model
# calls. REPLAY=1 answers from that cache and the fallback only, and never calls the model. The LLM_ settings
# must stay set: the cache is keyed by model name.
REPLAY=0
# Local only. Never set DB_PATH on Railway: the image keeps the database on the volume at /data.
DB_PATH=./data/thespis.sqlite
# Caps (#24). Model calls per session, and in all across every session and restart; 0 means no cap. Cache hits
# are free. Past a cap, NPCs fall back to code and template lines, and the game plays on.
SESSION_CALL_CAP=60
GLOBAL_CALL_CAP=0
# New sessions per client IP per hour; 0 turns it off. Judges at a venue may share one IP, so keep it generous.
SESSIONS_PER_IP_HOUR=30
# Opens GET /dev/calls, the call log across every session, which the harness and smoke test read. Unset, the endpoint
# doesn't exist. Generate one: python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_TOKEN=
# Azure AI Content Safety: checks player text before a model reads it and model lines before a player hears them.
# Unset, there's no model-based moderation. Thresholds are severities (0, 2, 4, 6) per category, as JSON, e.g.
# {"Hate": 4, "SelfHarm": 4, "Sexual": 4, "Violence": 6}, which is the default.
CONTENT_SAFETY_ENDPOINT=
CONTENT_SAFETY_KEY=
MODERATION_THRESHOLDS=
# Requests a second to Content Safety. 4 stays under the free tier's limit of 5; on the standard tier set 100.
CONTENT_SAFETY_RPS=4
# Origins allowed to call the API from a browser, comma-separated. Empty: none, which is right when the client is
# served from this server and Vite proxies the API in dev.
CORS_ORIGINS=
# 1 serves FastAPI's generated API docs at /docs. Keep it off on a public host.
API_DOCS=0
# json for one JSON object per log line (the image sets it), anything else for plain text.
LOG_FORMAT=text
