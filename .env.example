# Copy to .env and fill in. Never commit .env.
# Any OpenAI-compatible provider: the primary is tried first, then the backup, then the code fallback.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# Optional JSON merged into each request body, to switch thinking off where a provider needs it,
# e.g. {"enable_thinking": false} or {"thinking": {"type": "disabled"}}
LLM_EXTRA=
LLM_BACKUP_BASE_URL=
LLM_BACKUP_API_KEY=
LLM_BACKUP_MODEL=
LLM_BACKUP_EXTRA=
REPLAY=0
DB_PATH=./data/thespis.sqlite
SESSION_CALL_CAP=60
GLOBAL_CALL_CAP=0
