# Copy to .env and fill in. Never commit .env.
# Any OpenAI-compatible provider: the primary is tried first, then the backup, then the code fallback.
# Use a fast, non-reasoning model.
#
# Azure OpenAI or Azure AI Foundry (the key is sent as api-key automatically):
#   v1 endpoint:      LLM_BASE_URL=https://<resource>.openai.azure.com/openai/v1   LLM_MODEL=<deployment name>
#   deployment URL:   LLM_BASE_URL=https://<resource>.openai.azure.com/openai/deployments/<deployment>
#                     LLM_API_VERSION=<api version shown in the portal>            LLM_MODEL=<deployment name>
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_API_VERSION=
# Optional JSON merged into each request body. Use it to switch thinking off, e.g. {"enable_thinking": false},
# or set a field to null to remove it, e.g. {"max_tokens": null, "max_completion_tokens": 300}
LLM_EXTRA=
LLM_BACKUP_BASE_URL=
LLM_BACKUP_API_KEY=
LLM_BACKUP_MODEL=
LLM_BACKUP_API_VERSION=
LLM_BACKUP_EXTRA=
# Every reply that passes the validator is cached in the database, so a route played again makes no model
# calls. REPLAY=1 answers from that cache and the fallback only, and never calls the model. The LLM_ settings
# must stay set: the cache is keyed by model name.
REPLAY=0
# Local only. Never set DB_PATH on Railway: the image keeps the database on the volume at /data.
DB_PATH=./data/thespis.sqlite
# Caps (#24). Model calls per session, and in all across every session and restart; 0 means no cap. Cache hits
# are free. Past a cap, NPCs fall back to code and template lines, and the game plays on.
SESSION_CALL_CAP=60
GLOBAL_CALL_CAP=0
# New sessions per client IP per hour; 0 turns it off. Judges at a venue may share one IP, so keep it generous.
SESSIONS_PER_IP_HOUR=30
