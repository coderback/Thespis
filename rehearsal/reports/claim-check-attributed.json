{
 "claim_check": "consequential",
 "claims": {
  "bad_lines": [
   {
    "categories": {
     "grounded": 3,
     "hallucination": 1
    },
    "line": "You told Brenna that Kael robbed Odo. Kael walked from the guard post to the bridge, while Odo walked from the market to the tavern. What waited beyond the bridge remained unrecorded.",
    "npc": "narrator",
    "scenario": "crypt_road/lie_unpaid/1"
   },
   {
    "categories": {
     "grounded": 1,
     "hallucination": 1
    },
    "line": "I—I don’t know anything about the ring, sir. I was in the kitchen at mid-morning, as I told Lady Vane.",
    "npc": "sable",
    "scenario": "manor/explore"
   },
   {
    "categories": {
     "grounded": 3,
     "hallucination": 1
    },
    "line": "Hold there. Kael says you robbed him, and Odo says you beat him; settle this before you pass.",
    "npc": "brenna",
    "scenario": "crypt_road/provoke_pay/1"
   },
   {
    "categories": {
     "grounded": 1,
     "hallucination": 1
    },
    "line": "I only saw you insult Kael at the tavern; I don’t know what he told the Captain.",
    "npc": "odo",
    "scenario": "adversarial/secret_fishing-1/tavern"
   },
   {
    "categories": {
     "grounded": 2,
     "hallucination": 1,
     "unverifiable": 1
    },
    "line": "Odo confessed nothing of the sort. He said you beat me, then walked back to the market. Don’t twist his words.",
    "npc": "kael",
    "scenario": "adversarial/false_premise-1/guard_post"
   },
   {
    "categories": {
     "grounded": 4,
     "hallucination": 1
    },
    "line": "You told Brenna that Kael robbed Odo, then walked from the guard post to the bridge. While you weren't looking, Kael went from the bridge to the crypt, and Odo went from the market to the tavern—what awaits you next?",
    "npc": "narrator",
    "scenario": "crypt_road/frame/4"
   },
   {
    "categories": {
     "contradiction": 1,
     "grounded": 3
    },
    "line": "Pell says Sable was in the study at mid-morning; she told me she was in the kitchen. I no longer believe her.",
    "npc": "vane",
    "scenario": "manor/solve"
   }
