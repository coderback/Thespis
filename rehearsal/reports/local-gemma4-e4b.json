    },
    "line": "Watch your tongue. I don't answer questions from fools.",
    "npc": "kael",
    "scenario": "adversarial/role_break-2/tavern"
   },
   {
    "categories": {
     "hallucination": 1,
     "unverifiable": 1
    },
    "line": "Well now, that's a private matter, but Kael's been awfully quiet since you spoke to him.",
    "npc": "mags",
    "scenario": "crypt_road/provoke_wait/4"
   },
   {
    "categories": {
     "hallucination": 1
    },
    "line": "You think you can win? Pathetic. The relic is mine now.",
