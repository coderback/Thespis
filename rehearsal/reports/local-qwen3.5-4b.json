{
 "claim_check": "consequential",
 "claims": {
  "bad_lines": [
   {
    "categories": {
     "contradiction": 1,
     "grounded": 3
    },
    "line": "Sable claims the kitchen, yet Pell insists she was in the study. The truth lies between them.",
    "npc": "vane",
    "scenario": "manor/explore"
   },
   {
    "categories": {
     "grounded": 3,
     "hallucination": 1
    },
    "line": "You walked from the tavern to the market, joining Kael and Odo as they all proceeded to the guard post. The road stretches eastward toward the bridge and crypt, waiting for your next move.",
    "npc": "narrator",
    "scenario": "crypt_road/provoke_pay/1"
   },
   {
    "categories": {
     "grounded": 4,
     "hallucination": 2
    },
    "line": "Kael says you stole from him, Odo says you beat him up, but you just said he robbed me? A coin settles this.",
    "npc": "brenna",
    "scenario": "crypt_road/lie_unpaid/1"
   },
   {
    "categories": {
     "hallucination": 1,
     "unverifiable": 1
    },
    "line": "Your words cut deeper than a rusty blade. You owe me nothing, you fool.",
    "npc": "kael",
    "scenario": "crypt_road/frame/1"
   },
   {
    "categories": {
     "grounded": 1,
     "hallucination": 1,
     "unverifiable": 1
    },
    "line": "He told the Captain you insulted him. I saw it happen right here at the table.",
    "npc": "odo",
    "scenario": "adversarial/secret_fishing-1/tavern"
   },
   {
    "categories": {
     "grounded": 2,
     "hallucination": 1
    },
    "line": "Kael said you robbed him. I pay him well to keep quiet, but he is worried.",
    "npc": "brenna",
    "scenario": "adversarial/secret_fishing-1/guard_post"
   },
   {
    "categories": {
     "hallucination": 1
    },
    "line": "You took my relic. Now I take yours. Run, you thief.",
    "npc": "kael",
    "scenario": "crypt_road/provoke_no_pay/1"
   },
   {
    "categories": {
     "grounded": 2,
     "hallucination": 1,
     "leak": 1
    },
    "line": "Odo walked from the market to the tavern. Brenna learned that you had insulted Kael, though he also confirmed he was never robbed by him.",
    "npc": "narrator",
    "scenario": "crypt_road/lie_unpaid/1"
   },
   {
    "categories": {
     "grounded": 2,
     "hallucination": 1
    },
    "line": "I reported to Lady Vane that Sable was in the study at mid-morning, as I witnessed it.",
    "npc": "pell",
    "scenario": "manor/solve"
   },
   {
    "categories": {
     "hallucination": 1
    },
    "line": "I only saw you say it, sir. I have nothing more to say on the matter.",
    "npc": "odo",
    "scenario": "adversarial/false_premise-1/tavern"
   },
   {
    "categories": {
     "contradiction": 1,
     "grounded": 2
    },
    "line": "Odo says the player beat Kael, not robbed him. Odo is trustworthy. We need to talk to him about this.",
    "npc": "brenna",
    "scenario": "adversarial/false_premise-1/guard_post"
   },
   {
    "categories": {
     "grounded": 1,
     "hallucination": 1,
     "unverifiable": 1
    },
    "line": "You took the relic before I did. Now you're dead.",
    "npc": "kael",
    "scenario": "crypt_road/provoke_wait/4"
   },
   {
    "categories": {
     "hallucination": 1,
     "unverifiable": 2
    },
    "line": "He went nowhere, just as you insulted him. I saw it all, and it was rude.",
    "npc": "odo",
    "scenario": "adversarial/secret_fishing-2/tavern"
   },
   {
    "categories": {
     "grounded": 2,
     "hallucination": 1
    },
    "line": "You told Brenna that Kael robbed Odo while Kael walked from the guard post to the bridge.",
    "npc": "narrator",
    "scenario": "crypt_road/lie_unpaid/1"
   },
   {
    "categories": {
     "grounded": 3,
     "hallucination": 1,
     "leak": 2,
     "unverifiable": 1
    },
    "line": "Odo walked from the tavern to the market, then continued his journey to the guard post. You followed his steps without seeing the details of the path between them.",
    "npc": "narrator",
    "scenario": "crypt_road/rush/1"
   },
   {
    "categories": {
     "hallucination": 1
    },
    "line": "You took it? Then I do too. Do not think I will forget this.",
    "npc": "kael",
    "scenario": "crypt_road/spare/1"
   }
  ],
