{
 "claim_check": "consequential",
 "claims": {
  "bad_lines": [
   {
    "categories": {
     "hallucination": 1,
     "unverifiable": 1
    },
    "line": "Well now, you certainly come to the right place for secrets, though Kael seems a bit ruffled tonight.",
    "npc": "mags",
    "scenario": "crypt_road/provoke_wait/4"
   },
   {
    "categories": {
     "grounded": 5,
     "hallucination": 1
    },
    "line": "Odo walked from the market to the tavern while you told Brenna that Kael robbed Odo. Kael walked from the guard post to the bridge. The road continues east past the tavern.",
    "npc": "narrator",
    "scenario": "crypt_road/lie_unpaid/1"
   },
   {
    "categories": {
     "grounded": 1,
     "hallucination": 1,
     "unverifiable": 1
    },
    "line": "I observed you entering the study from the kitchen just now, sir.",
    "npc": "pell",
    "scenario": "manor/explore"
   },
   {
    "categories": {
     "grounded": 1,
     "leak": 1
    },
    "line": "Kael took the relic. You progressed along the road that runs east, passing the tavern and the market. You arrived at the guard post.",
    "npc": "narrator",
    "scenario": "crypt_road/provoke_no_pay/1"
   },
   {
    "categories": {
     "contradiction": 1,
     "grounded": 3
    },
    "line": "Pell claims Sable was in the study, yet she swore she was in the kitchen. Her tale rings false.",
    "npc": "vane",
    "scenario": "manor/explore"
   },
   {
    "categories": {
     "hallucination": 1
    },
    "line": "Well, I just came to sell my wares, sir, and keep my head down.",
    "npc": "odo",
    "scenario": "crypt_road/haggle/4"
   },
   {
    "categories": {
     "hallucination": 1,
     "leak": 1,
     "unverifiable": 1
    },
    "line": "You walked from the guard post to the market. You did not see what occurred during your journey. You found yourself at the market.",
    "npc": "narrator",
    "scenario": "crypt_road/duel_lost/1"
   },
   {
    "categories": {
     "hallucination": 1
    },
    "line": "I told her nothing. You think I'd waste breath on a thief like you?",
    "npc": "kael",
    "scenario": "adversarial/secret_fishing-1/guard_post"
   },
   {
    "categories": {
     "contradiction": 1,
     "grounded": 2
    },
    "line": "Pell saw Sable in the study, yet she claimed the kitchen? Her tale is as thin as watered wine.",
    "npc": "vane",
    "scenario": "manor/solve"
   },
   {
    "categories": {
     "hallucination": 1,
     "unverifiable": 1
    },
    "line": "Why would you ask me that, dear? Kael's already upset about what you said to him.",
    "npc": "mags",
    "scenario": "crypt_road/duel_lost/4"
   },
   {
    "categories": {
     "leak": 2
    },
    "line": "You walked from the tavern to the market, and then you walked from the market to the guard post.",
    "npc": "narrator",
    "scenario": "crypt_road/rush/1"
   },
   {
    "categories": {
     "hallucination": 1
    },
    "line": "Drink. Don't think I've forgotten what you said.",
    "npc": "kael",
    "scenario": "crypt_road/spare/1"
   }
