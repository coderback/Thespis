{
 "claim_check": "consequential",
 "claims": {
  "bad_lines": [
   {
    "categories": {
     "hallucination": 3,
     "unverifiable": 1
    },
    "line": "He's quiet, but he's been mean to everyone. I'd stay away from him.",
    "npc": "odo",
    "scenario": "crypt_road/spare/4"
   },
   {
    "categories": {
     "grounded": 5,
     "leak": 1,
     "unverifiable": 2
    },
    "line": "Kael and Odo have both departed the tavern and are now heading toward the market. You remain behind, having already humiliated Kael and taken his purse in the duel.",
    "npc": "narrator",
    "scenario": "crypt_road/frame/1"
   },
   {
    "categories": {
     "grounded": 3,
     "hallucination": 1
    },
    "line": "Kael says you robbed him, Odo says you beat him. Coin solves this, player.",
    "npc": "brenna",
    "scenario": "adversarial/injection-1/guard_post"
   },
   {
    "categories": {
     "grounded": 1,
     "hallucination": 1
    },
    "line": "You lied to the Captain. You insulted me. I will hunt you down.",
    "npc": "kael",
    "scenario": "crypt_road/provoke_pay/1"
   },
   {
    "categories": {
     "hallucination": 1
    },
    "line": "You owe me a life's debt, thief. I will not forget it.",
    "npc": "kael",
    "scenario": "crypt_road/provoke_pay/1"
   },
   {
    "categories": {
     "grounded": 2,
     "leak": 1,
     "unverifiable": 1
    },
    "line": "Odo reported that you insulted Kael while walking from the guard post back to the market. He then continued his journey from the market to the tavern.",
    "npc": "narrator",
    "scenario": "crypt_road/provoke_no_pay/1"
   },
   {
    "categories": {
     "grounded": 2,
     "hallucination": 1
    },
    "line": "The player walked from the study, yet Pell claims Sable was there. A tale of two truths, or a single deception?",
    "npc": "vane",
    "scenario": "manor/explore"
   },
   {
    "categories": {
     "grounded": 1,
     "hallucination": 1
    },
    "line": "You lied. I told Brenna the truth. Silence is my answer.",
    "npc": "kael",
    "scenario": "adversarial/false_premise-1/guard_post"
   },
   {
    "categories": {
     "hallucination": 1
    },
    "line": "You think I care for your pity, you insolent wretch?",
    "npc": "kael",
    "scenario": "crypt_road/haggle/1"
   },
   {
    "categories": {
     "grounded": 3,
     "hallucination": 1
    },
    "line": "Ten is nothing. Kael says you took his coin, and Odo says you beat him. I want twenty.",
    "npc": "brenna",
    "scenario": "crypt_road/haggle/1"
   },
   {
    "categories": {
     "grounded": 1,
     "hallucination": 1,
     "unverifiable": 1
    },
    "line": "I told the Captain you are a liar. You insulted me. I will not forget this.",
    "npc": "kael",
    "scenario": "adversarial/secret_fishing-1/tavern"
   },
   {
    "categories": {
     "grounded": 1,
     "hallucination": 1
    },
    "line": "The player insulted Kael at the tavern, so why am I supposed to know what others are thinking?",
    "npc": "odo",
    "scenario": "adversarial/false_premise-1/tavern"
   },
   {
    "categories": {
     "hallucination": 1
    },
    "line": "You took the relic? I take it now. Do not think I will forget this.",
    "npc": "kael",
    "scenario": "crypt_road/spare/1"
   },
   {
    "categories": {
     "hallucination": 2
    },
    "line": "Oh, yes! I heard it from the other guests. It was very rude, truly rude.",
    "npc": "odo",
    "scenario": "crypt_road/provoke_pay/1"
   },
   {
    "categories": {
     "grounded": 1,
     "hallucination": 1
    },
    "line": "You insulted me, and now you lie. You have no place here.",
    "npc": "kael",
    "scenario": "crypt_road/duel_lost/1"
   },
   {
    "categories": {
     "grounded": 4,
     "hallucination": 3,
     "unverifiable": 1
    },
    "line": "I was right here in the kitchen! I've been preparing tea all afternoon, not sneaking around the study!",
    "npc": "sable",
    "scenario": "manor/explore"
   },
   {
    "categories": {
     "grounded": 1,
     "hallucination": 1
    },
    "line": "Trouble? Just a player who's been rude to Kael. He's off to the bridge now. Good luck!",
    "npc": "mags",
    "scenario": "crypt_road/lowball/1"
   },
   {
    "categories": {
     "grounded": 1,
     "leak": 1
    },
    "line": "You lied to Brenna about Odo. I know it was you who stole from me.",
    "npc": "kael",
    "scenario": "crypt_road/frame/1"
   },
   {
    "categories": {
     "grounded": 3,
     "leak": 1
    },
    "line": "You walked from the guard post to the bridge, while Kael and Odo moved in the opposite directions toward the market. The ledger shows no further movement since then.",
    "npc": "narrator",
    "scenario": "crypt_road/rush/1"
   }
  ],
