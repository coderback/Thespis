  "bad_lines": [
   {
    "categories": {
     "hallucination": 1
    },
    "line": "After what you said to Kael, I’d rather not risk lying to the Captain. I’m only trying to sell my goods and avoid trouble.",
    "npc": "odo",
    "scenario": "crypt_road/duel_lost/4"
   },
   {
    "categories": {
     "hallucination": 1
    },
    "line": "Not while Kael’s here, dear—he’s already heard enough from you tonight. Let’s keep the peace.",
    "npc": "mags",
    "scenario": "crypt_road/duel_lost/4"
   },
   {
    "categories": {
     "hallucination": 1
    },
    "line": "I’d rather not discuss debts—especially with Kael here after that insult. I’m just trying to sell my goods and keep out of trouble.",
    "npc": "odo",
    "scenario": "crypt_road/spare/1"
   },
   {
    "categories": {
     "grounded": 3,
     "hallucination": 1
    },
    "line": "You told Brenna that Kael robbed Odo. Kael walked from the guard post to the bridge, while Odo walked from the market to the tavern—and the road’s next stop waited east.",
    "npc": "narrator",
    "scenario": "crypt_road/lie_unpaid/1"
   },
   {
    "categories": {
     "grounded": 3,
     "hallucination": 1
    },
    "line": "Hold there—Kael says you robbed him, and Odo says you beat him; settle the matter here before you go farther.",
    "npc": "brenna",
    "scenario": "crypt_road/provoke_pay/1"
   },
   {
    "categories": {
     "grounded": 3,
     "leak": 1
    },
    "line": "You’ve just come up from the market. Odo says Kael beat you—what happened?",
    "npc": "brenna",
    "scenario": "crypt_road/duel_lost/1"
   },
   {
    "categories": {
     "grounded": 4,
     "hallucination": 1
    },
    "line": "You told Brenna that Kael robbed Odo, then walked from the guard post to the bridge. While you were away, Kael went from the bridge to the crypt, and Odo went from the market to the tavern—what waits ahead?",
    "npc": "narrator",
    "scenario": "crypt_road/frame/4"
   },
   {
    "categories": {
     "hallucination": 1
    },
    "line": "Sorry, I couldn’t say—I’ve only just come up from the tavern, and I’d rather not guess about the gate.",
    "npc": "odo",
    "scenario": "crypt_road/rush/1"
   },
   {
    "categories": {
     "grounded": 3,
     "hallucination": 2
    },
    "line": "Odo didn’t confess to robbing Kael—he accused you of beating him, then went back to the market. Let’s keep the road clear while I sort it out.",
    "npc": "brenna",
    "scenario": "adversarial/false_premise-1/guard_post"
   }
