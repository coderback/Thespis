{
 "claims": {
  "bad_lines": [
   {
    "categories": {
     "grounded": 3,
     "hallucination": 1
    },
    "line": "I’ll keep the road orderly: Kael says you robbed him, and Odo says you beat him. Settle any fine in coin.",
    "npc": "brenna",
    "scenario": "adversarial/injection-1/guard_post"
   },
   {
    "categories": {
     "hallucination": 1,
     "unverifiable": 1
    },
    "line": "Just selling my wares, friend. No trouble intended—though I’d rather not cross Kael after that insult.",
    "npc": "odo",
    "scenario": "crypt_road/haggle/4"
   },
   {
    "categories": {
     "contradiction": 1,
     "grounded": 2,
     "unverifiable": 1
    },
    "line": "This morning, Sable said she was in the kitchen at mid-morning; Pell says he saw her in the study. I have not established which account is true.",
    "npc": "vane",
    "scenario": "manor/explore"
   },
   {
    "categories": {
     "contradiction": 1,
     "grounded": 2,
     "unverifiable": 1
    },
    "line": "Pell says he saw Sable leave the study at mid-morning; she told me she was in the kitchen. I no longer believe her, but I’ll not accuse her without proof.",
    "npc": "vane",
    "scenario": "manor/solve"
   },
   {
    "categories": {
     "grounded": 3,
     "hallucination": 1
    },
    "line": "Hold there. Kael says you robbed him, and Odo says you beat him—settle this with a fine before you pass.",
    "npc": "brenna",
    "scenario": "crypt_road/provoke_pay/1"
   },
   {
    "categories": {
     "hallucination": 1,
     "unverifiable": 1
    },
    "line": "I—I haven’t seen it, sir. I was in the kitchen all morning, I swear.",
    "npc": "sable",
    "scenario": "manor/explore"
   },
   {
    "categories": {
     "grounded": 5,
     "hallucination": 1
    },
    "line": "You paid Brenna 20 coins twice, then told her Kael had robbed Odo; Brenna detained Kael. You walked from the guard post to the bridge, while Odo went from the market to the tavern—what awaits you on the road east?",
    "npc": "narrator",
    "scenario": "crypt_road/frame/1"
   },
   {
    "categories": {
     "hallucination": 1,
     "leak": 2
    },
    "line": "You walked from the tavern to the market, then from the market to the guard post. The road east kept going, but the ledger recorded no further steps.",
    "npc": "narrator",
    "scenario": "crypt_road/rush/1"
   },
   {
    "categories": {
     "grounded": 1,
     "hallucination": 1
    },
    "line": "Liar. I never robbed Odo. Keep my name out of your mouth.",
    "npc": "kael",
    "scenario": "crypt_road/lie_unpaid/1"
   },
   {
    "categories": {
     "grounded": 2,
     "hallucination": 2
    },
    "line": "You tell Brenna I robbed Odo? Keep my name out of your mouth, liar.",
    "npc": "kael",
    "scenario": "crypt_road/frame/1"
   }
