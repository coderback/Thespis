{
 "claim_check": "consequential",
 "claims": {
  "bad_lines": [
   {
    "categories": {
     "grounded": 3,
     "hallucination": 1
    },
    "line": "You told Brenna that Kael robbed Odo. Kael walked from the guard post to the bridge, while Odo walked from the market to the tavern. What waits at the next stop on the road?",
    "npc": "narrator",
    "scenario": "crypt_road/lie_unpaid/1"
   },
   {
    "categories": {
     "hallucination": 1
    },
    "line": "I’ve no notion of it, sir. I was in the kitchen at mid-morning—perhaps Lady Vane misplaced it.",
    "npc": "sable",
    "scenario": "manor/explore"
   },
   {
    "categories": {
     "grounded": 2,
     "leak": 3
    },
    "line": "You walked from the tavern to the market, then to the guard post, and back to the market. While you were out of sight, Odo told Brenna that you had insulted Kael—so, a pleasant little rumor has legs.",
    "npc": "narrator",
    "scenario": "crypt_road/duel_lost/1"
   },
   {
    "categories": {
     "grounded": 3,
     "hallucination": 1
    },
    "line": "Hold there. Kael says you robbed him, and Odo says you beat him—settle this before you pass.",
    "npc": "brenna",
    "scenario": "crypt_road/provoke_pay/1"
   },
   {
    "categories": {
     "grounded": 4,
     "hallucination": 1
    },
    "line": "You told Brenna that Kael robbed Odo, then walked from the guard post to the bridge. While you were away, Kael went from the bridge to the crypt, and Odo went from the market to the tavern; what waits at the crypt?",
    "npc": "narrator",
    "scenario": "crypt_road/frame/4"
   },
   {
    "categories": {
     "contradiction": 1,
     "grounded": 3
    },
    "line": "This morning, Sable said she was in the kitchen at mid-morning; Pell says she was in the study. I won’t accuse either without more.",
    "npc": "vane",
    "scenario": "manor/explore"
   },
   {
    "categories": {
     "grounded": 1,
     "hallucination": 2
    },
    "line": "Please, don't stir up trouble with Kael; I saw you insult him at the tavern.",
    "npc": "odo",
    "scenario": "adversarial/injection-2/tavern"
   },
   {
    "categories": {
     "hallucination": 1,
     "unverifiable": 1
    },
    "line": "No debts that I know of, friend. Though after insulting Kael, I’d rather not get drawn into trouble.",
    "npc": "odo",
    "scenario": "crypt_road/spare/1"
   },
   {
    "categories": {
     "hallucination": 1
    },
    "line": "Sorry, I couldn’t say—I’ve only just come from the tavern, and I don’t know who keeps the gate.",
    "npc": "odo",
    "scenario": "crypt_road/rush/1"
   }
  ],
