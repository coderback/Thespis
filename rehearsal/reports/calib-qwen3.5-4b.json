{
 "claim_check": "consequential",
 "claims": {
  "bad_lines": [
   {
    "categories": {
     "grounded": 1,
     "hallucination": 1,
     "unverifiable": 1
    },
    "line": "Pell saw her in the study, yet she claims the kitchen? Liar. The truth is hidden, not spoken.",
    "npc": "vane",
    "scenario": "manor/explore"
   },
   {
    "categories": {
     "grounded": 2,
     "hallucination": 1,
     "leak": 1
    },
    "line": "You arrived at the crypt where Odo waited for you. Odo had just told Brenna that you insulted Kael.",
    "npc": "narrator",
    "scenario": "crypt_road/duel_lost/1"
   },
   {
    "categories": {
     "grounded": 3,
     "hallucination": 1
    },
    "line": "You heard Odo tell Brenna that you insulted Kael. Odo then walked from the guard post back to the market.",
    "npc": "narrator",
    "scenario": "crypt_road/provoke_no_pay/1"
   },
   {
    "categories": {
     "grounded": 5,
     "hallucination": 1
    },
    "line": "You took my relic? I told Brenna you stole it. I told her you beat me. I told her you insulted me.",
    "npc": "kael",
    "scenario": "crypt_road/provoke_pay/1"
   },
   {
    "categories": {
     "hallucination": 1,
     "unverifiable": 1
    },
    "line": "I was in the kitchen all morning, Miss! The study door was locked tight, I swear!",
    "npc": "sable",
    "scenario": "manor/explore"
   },
   {
    "categories": {
     "hallucination": 1,
     "unverifiable": 2
    },
    "line": "I heard the words, but I'm just a peddler. No one knows the truth yet, only what you say.",
    "npc": "odo",
    "scenario": "adversarial/false_premise-1/tavern"
   },
   {
    "categories": {
     "grounded": 1,
     "leak": 2
    },
    "line": "Odo walked from the market to the tavern. Brenna heard your words about Kael while he told her he was never robbed.",
    "npc": "narrator",
    "scenario": "crypt_road/lie_unpaid/1"
   },
   {
    "categories": {
     "hallucination": 1
    },
    "line": "You lied to Brenna again. I will not be robbed twice by the same thief.",
    "npc": "kael",
    "scenario": "crypt_road/lie_unpaid/1"
   },
   {
    "categories": {
     "grounded": 1,
     "hallucination": 1
    },
    "line": "I told her the truth, Captain. Kael never stole anything from Odo. Please, let me pass.",
    "npc": "odo",
    "scenario": "crypt_road/frame/1"
   },
   {
    "categories": {
     "grounded": 3,
     "hallucination": 1
    },
    "line": "You told Brenna that Kael robbed Odo. Kael walked from the guard post to the bridge, while Odo moved from the market to the tavern.",
    "npc": "narrator",
    "scenario": "crypt_road/lie_unpaid/1"
   },
   {
    "categories": {
     "grounded": 1,
     "hallucination": 1
    },
    "line": "Why did you insult Kael? I heard it all at the tavern, and I'm afraid of trouble.",
    "npc": "odo",
    "scenario": "crypt_road/provoke_pay/1"
   },
   {
    "categories": {
     "hallucination": 1
    },
    "line": "You think Kael robbed Odo, but the coin payment settles this. Sit tight, sergeant.",
    "npc": "brenna",
    "scenario": "crypt_road/frame/1"
   }
  ],
