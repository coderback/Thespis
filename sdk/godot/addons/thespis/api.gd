class UsageOut extends RefCounted:
	var at: float = 0.0
	var call_type: String = ""
	var completion_tokens = null  ## integer, or null
	var kind: String = ""  ## call (a model call), line (a line settled) or capped (a call the caps refused)
	var latency_ms = null  ## integer, or null
	var ok: bool = false
	var project: String = ""
	var prompt_tokens = null  ## integer, or null
	var provider = null  ## string, or null
	var session = null  ## string, or null
	var source = null  ## string, or null. For a line: llm, cache or fallback. For capped: which cap

	func read(d: Dictionary):
		if d.has("at"): at = float(d["at"])
		if d.has("call_type"): call_type = str(d["call_type"])
		completion_tokens = int(d["completion_tokens"]) if d.get("completion_tokens") != null else null
		if d.has("kind"): kind = str(d["kind"])
		latency_ms = int(d["latency_ms"]) if d.get("latency_ms") != null else null
