		if d.has("project"): project = str(d["project"])
		prompt_tokens = int(d["prompt_tokens"]) if d.get("prompt_tokens") != null else null
		provider = str(d["provider"]) if d.get("provider") != null else null
		session = str(d["session"]) if d.get("session") != null else null
		source = str(d["source"]) if d.get("source") != null else null
		return self

	func to_dict() -> Dictionary:
		var d := {}
		d["at"] = at
		d["call_type"] = call_type
		if completion_tokens != null: d["completion_tokens"] = completion_tokens
		d["kind"] = kind
		if latency_ms != null: d["latency_ms"] = latency_ms
		d["ok"] = ok
		d["project"] = project
		if prompt_tokens != null: d["prompt_tokens"] = prompt_tokens
		if provider != null: d["provider"] = provider
		if session != null: d["session"] = session
		if source != null: d["source"] = source
